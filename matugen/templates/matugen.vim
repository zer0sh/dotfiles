  let s:I2 = [ '{{colors.on_surface.default.hex}}', '{{colors.surface_container_high.default.hex}}', 0, 0 ]
  let s:I3 = [ '{{colors.on_surface_variant.default.hex}}', '{{colors.surface_container.default.hex}}', 0, 0 ]

  let s:V1 = [ '{{colors.on_secondary.default.hex}}', '{{colors.secondary.default.hex}}', 0, 0 ]
  let s:V2 = [ '{{colors.on_surface.default.hex}}', '{{colors.surface_container_high.default.hex}}', 0, 0 ]
  let s:V3 = [ '{{colors.on_surface_variant.default.hex}}', '{{colors.surface_container.default.hex}}', 0, 0 ]

  let s:RE = [ '{{colors.on_error.default.hex}}', '{{colors.error.default.hex}}', 0, 0 ]

  let g:airline#themes#matugen#palette = {}
  let g:airline#themes#matugen#palette.normal = airline#themes#generate_color_map(s:N1, s:N2, s:N3)
  let g:airline#themes#matugen#palette.normal_modified = {
        \ 'airline_c': [ '{{colors.primary.default.hex}}', '{{colors.surface_container.default.hex}}', 0, 0, '' ] }

  let g:airline#themes#matugen#palette.insert = airline#themes#generate_color_map(s:I1, s:I2, s:I3)
