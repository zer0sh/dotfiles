  let s:N1 = [ '{{colors.on_primary.default.hex}}', '{{colors.primary.default.hex}}', 0, 0 ]
  let s:N2 = [ '{{colors.on_surface.default.hex}}', '{{colors.surface_container_high.default.hex}}', 0, 0 ]
