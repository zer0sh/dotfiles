#!/bin/bash

LANG="${1:-spa+eng}"

REGION=$(slurp 2>/dev/null)
if [ -z "$REGION" ]; then
    notify-send "OCR" "Selección cancelada"
    exit 1
fi

RESULT=$(grim -g "$REGION" - | tesseract stdin stdout -l "$LANG" 2>/dev/null)

if [ -z "$RESULT" ]; then
    notify-send "OCR" "No se detectó texto"
    exit 1
fi

wl-copy "$RESULT"
notify-send "OCR" "$(echo "$RESULT" | head -c 200)"
