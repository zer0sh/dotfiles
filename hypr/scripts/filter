#!/usr/bin/env bash
# Screen filter controller for Hyprland

SHADER_DIR="$HOME/.config/hypr/shaders"
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/hypr-bw-filter"

apply_shader() {
    local name="$1"
    local shader="$2"

    echo "$name" > "$STATE_FILE"
    hyprctl keyword decoration:screen_shader "$shader"
    notify-send "Screen Filter" "Filter: $name"
}

case "$1" in
    sepia)
        apply_shader "Sepia Vintage" "$SHADER_DIR/sepia.glsl"
        ;;
    bw|grayscale)
        apply_shader "Black and White" "$SHADER_DIR/bw.glsl"
        ;;
    noir)
        apply_shader "Film Noir" "$SHADER_DIR/noir.glsl"
        ;;
    vintage)
        apply_shader "Vintage" "$SHADER_DIR/vintage.glsl"
        ;;
    vivid)
        apply_shader "Vivid" "$SHADER_DIR/vivid.glsl"
        ;;
    crt)
        apply_shader "CRT Retro" "$SHADER_DIR/crt.glsl"
        ;;
    crt-soft|crtsoft)
        apply_shader "CRT Soft" "$SHADER_DIR/crt-soft.glsl"
        ;;
    trinitron)
        apply_shader "Sony Trinitron" "$SHADER_DIR/trinitron.glsl"
        ;;
    off|reset|none)
        rm -f "$STATE_FILE"
        hyprctl keyword decoration:screen_shader "$SHADER_DIR/off.glsl"
        notify-send "Screen Filter" "Disabled"
        ;;
    toggle)
        if [ -f "$STATE_FILE" ]; then
            "$0" off
        else
            "$0" sepia
        fi
        ;;
    status)
        if [ -f "$STATE_FILE" ]; then
            echo "Active filter: $(cat "$STATE_FILE")"
        else
            echo "Filter: disabled"
        fi
        ;;
    *)
        echo "Usage: $0 {sepia|bw|noir|vintage|vivid|crt|crt-soft|trinitron|off|toggle|status}"
        exit 1
        ;;
esac
