#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="$HOME/.config/themes/current/wallpaper"
FALLBACK="$HOME/Pictures/walls/wa1.png"

wallpaper="$FALLBACK"
if [[ -s "$STATE_FILE" ]]; then
    wallpaper="$(<"$STATE_FILE")"
fi

if [[ ! -f "$wallpaper" ]]; then
    wallpaper="$FALLBACK"
fi

# Quickshell es el gestor principal de fondo animado
if pgrep -x quickshell >/dev/null 2>&1 || pgrep -f "qs.*shell.qml" >/dev/null 2>&1; then
    pkill -x swaybg 2>/dev/null || true
    quickshell ipc call wallpaper set "$wallpaper" 2>/dev/null || true
else
    pkill -x swaybg 2>/dev/null || true
    swaybg -o eDP-1 -i "$wallpaper" -m fill &
    swaybg -o HDMI-A-1 -i "$wallpaper" -m fill &
    wait
fi
