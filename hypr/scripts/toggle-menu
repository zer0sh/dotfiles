#!/usr/bin/env bash
# ==============================================================================
# Toggle launcher para Quickshell Caelestia (con fallback a Wofi)
# ==============================================================================

if pgrep -x quickshell >/dev/null 2>&1 || pgrep -f "qs.*shell.qml" >/dev/null 2>&1; then
    quickshell ipc call launcher toggle
else
    if pidof wofi >/dev/null 2>&1; then
        killall wofi
    else
        exec wofi --conf "$HOME/.config/wofi/config" --style "$HOME/.config/wofi/style.css" --show drun
    fi
fi
