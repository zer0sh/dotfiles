#!/usr/bin/env bash
# Waybar nightlight status / toggle
if [ "$1" = "toggle" ]; then
    if pgrep -x hyprsunset >/dev/null 2>&1; then
        pkill -x hyprsunset
        qs ipc call osd notify "󰖔|NIGHT LIGHT|OFF|secondary" 2>/dev/null || true
    else
        setsid nohup hyprsunset -t 4000 >/dev/null 2>&1 < /dev/null &
        qs ipc call osd notify "󰖔|NIGHT LIGHT|ON (4000K)|primary" 2>/dev/null || true
    fi
    pkill -RTMIN+9 waybar 2>/dev/null || true
    exit 0
fi

if pgrep -x hyprsunset >/dev/null 2>&1; then
    echo '{"text": "󰈈", "class": "active", "tooltip": "Night light active (4000K)"}'
else
    echo '{"text": "", "class": "hidden"}'
fi
