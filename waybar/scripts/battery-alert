#!/usr/bin/env bash

# Battery alert daemon for Waybar & Hyprland
# Features:
# - Notifications at 30%, 10%, and 5% (ultimatum) when discharging
# - Notification when charging begins
# - Blinking red animation on the Waybar status pill when discharging <= 30%
# - Dynamic animation speeds: warning (1.0s), critical (0.6s), ultimatum (0.35s)

set -euo pipefail

ALERT_CSS="${HOME}/.config/waybar/battery-alert.css"
LOCK_FILE="/tmp/waybar-battery-alert.lock"

# Ensure single instance
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    exit 0
fi

# Locate battery sysfs directory
BAT_PATH=""
for b in /sys/class/power_supply/BAT*; do
    if [ -d "$b" ]; then
        BAT_PATH="$b"
        break
    fi
done

if [ -z "$BAT_PATH" ]; then
    # Desktop or no battery detected
    exit 0
fi

# Track alert states
NOTIFIED_30=0
NOTIFIED_10=0
NOTIFIED_5=0
CHARGING_NOTIFIED=0
CURRENT_BLINK_LEVEL="init"

# Reset CSS and reload Waybar on exit
cleanup() {
    cat << 'EOF' > "$ALERT_CSS"
/* Battery alert: normal / idle */
EOF
    pkill -SIGUSR2 -x waybar 2>/dev/null || true
    exit 0
}

trap cleanup SIGINT SIGTERM

is_charging_or_ac() {
    local status
    status=$(cat "${BAT_PATH}/status" 2>/dev/null || echo "Unknown")
    if [ "$status" = "Charging" ] || [ "$status" = "Full" ]; then
        return 0
    fi

    for ac in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
        if [ -f "$ac/online" ] && [ "$(cat "$ac/online" 2>/dev/null)" = "1" ]; then
            return 0
        fi
    done

    return 1
}

trigger_qs_alert() {
    local level="$1"
    local pct="$2"
    local title="$3"
    local msg="$4"

    quickshell ipc call battery alert "$level" "$pct" "$title" "$msg" 2>/dev/null || \
    qs ipc call battery alert "$level" "$pct" "$title" "$msg" 2>/dev/null || true
}

apply_blink_style() {
    local level="$1"
    local duration="1.0s"
    local bg_alpha="rgba(230, 40, 40, 0.40)"
    local text_color="#ff6b6b"

    if [ "$level" = "critical" ]; then
        duration="0.6s"
        bg_alpha="rgba(230, 30, 30, 0.55)"
        text_color="#ff4d4d"
    elif [ "$level" = "ultimatum" ]; then
        duration="0.35s"
        bg_alpha="rgba(240, 15, 15, 0.70)"
        text_color="#ff2222"
    fi

    cat << EOF > "$ALERT_CSS"
/* Battery alert: $level */
@keyframes battery-pill-blink {
    0% {
        background-color: alpha(@text, 0.08);
        color: @text;
    }
    50% {
        background-color: $bg_alpha;
        color: $text_color;
    }
    100% {
        background-color: alpha(@text, 0.08);
        color: @text;
    }
}

#custom-date,
#clock,
#pulseaudio,
#pulseaudio.muted,
#network,
#network.disconnected,
#bluetooth,
#bluetooth.disabled,
#battery,
#battery.warning,
#battery.critical,
#custom-power {
    animation-name: battery-pill-blink;
    animation-duration: $duration;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    transition: none;
}
EOF
    pkill -SIGUSR2 -x waybar 2>/dev/null || true
}

clear_blink_style() {
    cat << 'EOF' > "$ALERT_CSS"
/* Battery alert: normal / idle */
EOF
    pkill -SIGUSR2 -x waybar 2>/dev/null || true
}

while true; do
    capacity=$(cat "${BAT_PATH}/capacity" 2>/dev/null || echo "100")
    capacity=${capacity:-100}

    if is_charging_or_ac; then
        # Charger connected / charging
        if [ "$CHARGING_NOTIFIED" -eq 0 ]; then
            notify-send -u normal -i battery-full-charging \
                "Cargador conectado" \
                "La batería se está cargando (Nivel actual: ${capacity}%)."
            trigger_qs_alert "charging" "$capacity" \
                "Cargador conectado" \
                "La batería se está cargando (${capacity}%)"
            CHARGING_NOTIFIED=1
        fi

        # Reset discharge notification flags when charged above thresholds
        if [ "$capacity" -gt 30 ]; then
            NOTIFIED_30=0
            NOTIFIED_10=0
            NOTIFIED_5=0
        elif [ "$capacity" -gt 10 ]; then
            NOTIFIED_10=0
            NOTIFIED_5=0
        elif [ "$capacity" -gt 5 ]; then
            NOTIFIED_5=0
        fi

        # Disable blinking if active
        if [ "$CURRENT_BLINK_LEVEL" != "none" ]; then
            clear_blink_style
            CURRENT_BLINK_LEVEL="none"
        fi
    else
        # Discharging on battery
        if [ "$CHARGING_NOTIFIED" -eq 1 ]; then
            CHARGING_NOTIFIED=0
        fi

        target_blink="none"

        if [ "$capacity" -le 5 ]; then
            target_blink="ultimatum"
            if [ "$NOTIFIED_5" -eq 0 ]; then
                notify-send -u critical -i battery-empty \
                    "Ultimátum de batería" \
                    "Nivel crítico: ${capacity}%. Conecta el cargador inmediatamente para evitar el apagado."
                trigger_qs_alert "ultimatum" "$capacity" \
                    "Ultimátum de batería" \
                    "Nivel crítico al ${capacity}% — Conecta el cargador inmediatamente"
                NOTIFIED_5=1
                NOTIFIED_10=1
                NOTIFIED_30=1
            fi
        elif [ "$capacity" -le 10 ]; then
            target_blink="critical"
            if [ "$NOTIFIED_10" -eq 0 ]; then
                notify-send -u critical -i battery-low \
                    "Batería crítica" \
                    "Nivel actual: ${capacity}%. Conecta el cargador pronto para evitar que el equipo se suspenda."
                trigger_qs_alert "critical" "$capacity" \
                    "Batería crítica" \
                    "Nivel al ${capacity}% — Conecta el cargador pronto"
                NOTIFIED_10=1
                NOTIFIED_30=1
            fi
        elif [ "$capacity" -le 30 ]; then
            target_blink="warning"
            if [ "$NOTIFIED_30" -eq 0 ]; then
                notify-send -u normal -i battery-caution \
                    "Batería baja" \
                    "Nivel actual: ${capacity}%. Considera conectar el cargador."
                trigger_qs_alert "warning" "$capacity" \
                    "Batería baja" \
                    "Nivel al ${capacity}% — Considera conectar el cargador pronto"
                NOTIFIED_30=1
            fi
        else
            # Battery > 30%
            NOTIFIED_30=0
            NOTIFIED_10=0
            NOTIFIED_5=0
            target_blink="none"
        fi

        # Update styling if blink level changed
        if [ "$target_blink" != "$CURRENT_BLINK_LEVEL" ]; then
            if [ "$target_blink" = "none" ]; then
                clear_blink_style
            else
                apply_blink_style "$target_blink"
            fi
            CURRENT_BLINK_LEVEL="$target_blink"
        fi
    fi

    # Poll every 5 seconds for responsive AC plug/unplug and alert transitions
    sleep 5
done
