#!/usr/bin/env python3
"""
Waybar media player module with 100% native D-Bus integration.
Completely eliminates subprocess forks and CLI overhead:
- Direct D-Bus IPC for MPRIS metadata and playback status.
- Event-driven via PropertiesChanged & NameOwnerChanged signals.
- In-memory marquee slicing at ~7 fps for ultra-smooth fluid scrolling.
- Zero CPU churn and zero process forks during execution.
"""

import os
import sys
import time
import json
import threading

import dbus
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

CACHE_DIR = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
TARGET_PLAYER_FILE = os.path.join(CACHE_DIR, "waybar-selected-player")
MAX_CHARS = 34
TICK_INTERVAL = 0.14  # ~7.1 chars/sec for smooth readable scrolling
SEP = "   •   "

# Initialize D-Bus with GLib mainloop
DBusGMainLoop(set_as_default=True)
bus = dbus.SessionBus()

# Shared state
state = {
    "status": "",
    "text": "",
}
lock = threading.Lock()

def query_dbus():
    """Query MPRIS directly over D-Bus without spawning any processes."""
    try:
        saved_target = ""
        if os.path.isfile(TARGET_PLAYER_FILE):
            try:
                with open(TARGET_PLAYER_FILE, "r") as f:
                    saved_target = f.read().strip()
            except Exception:
                pass

        all_names = [n for n in bus.list_names() if n.startswith("org.mpris.MediaPlayer2.")]
        if not all_names:
            with lock:
                state["status"] = ""
                state["text"] = ""
            return

        target_name = None
        if saved_target:
            for n in all_names:
                short = n.replace("org.mpris.MediaPlayer2.", "")
                if short.startswith(saved_target):
                    target_name = n
                    break

        if not target_name:
            # Prioritize currently Playing player, otherwise first available
            playing_candidate = None
            for n in all_names:
                try:
                    obj = bus.get_object(n, "/org/mpris/MediaPlayer2")
                    props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
                    st = str(props.Get("org.mpris.MediaPlayer2.Player", "PlaybackStatus"))
                    if st == "Playing":
                        playing_candidate = n
                        break
                except Exception:
                    continue
            target_name = playing_candidate or all_names[0]

        obj = bus.get_object(target_name, "/org/mpris/MediaPlayer2")
        props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
        status = str(props.Get("org.mpris.MediaPlayer2.Player", "PlaybackStatus"))
        meta = props.Get("org.mpris.MediaPlayer2.Player", "Metadata")

        title = str(meta.get("xesam:title", "")).strip()
        artist_val = meta.get("xesam:artist", "")
        if isinstance(artist_val, (list, dbus.Array)):
            artist = ", ".join(str(a).strip() for a in artist_val if str(a).strip())
        else:
            artist = str(artist_val).strip()

        if artist and title:
            full = f"{artist} - {title}"
        elif title:
            full = title
        elif artist:
            full = artist
        else:
            full = "Playing" if status == "Playing" else ""

        with lock:
            state["status"] = status
            state["text"] = full
    except Exception:
        with lock:
            state["status"] = ""
            state["text"] = ""

def choose_player():
    """Interactive GUI selector via wofi (only runs if 'choose' argument is passed)."""
    import subprocess
    script_dir = os.path.dirname(os.path.realpath(__file__))
    style_css = os.path.join(script_dir, "island-dropdown.css")
    
    players = [str(n).replace("org.mpris.MediaPlayer2.", "") for n in bus.list_names() if n.startswith("org.mpris.MediaPlayer2.")]
    players = sorted(list(set(players)))
    if not players:
        subprocess.run(["notify-send", "-t", "2500", "Media Source", "No active media players found"])
        sys.exit(0)

    menu = ["󰓇 Automatic (follow active)"] + [f"󰝚 {p}" for p in players]
    menu_input = "\n".join(menu)
    wofi = subprocess.run([
        "wofi", "--dmenu", "-p", "Media Source", "-i", "--lines", "5",
        "--width", "320", "--location", "top", "--yoffset", "42",
        "--style", style_css
    ], input=menu_input, capture_output=True, text=True)

    selected = wofi.stdout.strip()
    if not selected:
        sys.exit(0)

    if "Automatic" in selected:
        if os.path.exists(TARGET_PLAYER_FILE):
            try:
                os.remove(TARGET_PLAYER_FILE)
            except OSError:
                pass
        subprocess.run(["notify-send", "-t", "2000", "Media Source", "Automatic mode enabled"])
    else:
        clean = selected.replace("󰝚", "").strip()
        with open(TARGET_PLAYER_FILE, "w") as f:
            f.write(clean)
        subprocess.run(["notify-send", "-t", "2000", "Media Source", f"Selected: {clean}"])
    sys.exit(0)

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "choose":
        choose_player()

    # Initial D-Bus query
    query_dbus()

    # Event-driven listeners for instant updates without polling
    def on_dbus_signal(*args, **kwargs):
        query_dbus()

    bus.add_signal_receiver(
        on_dbus_signal,
        dbus_interface="org.freedesktop.DBus.Properties",
        signal_name="PropertiesChanged"
    )
    bus.add_signal_receiver(
        on_dbus_signal,
        dbus_interface="org.freedesktop.DBus",
        signal_name="NameOwnerChanged"
    )

    # Periodic heartbeat (every 2 seconds) inside GLib event loop
    def heartbeat():
        query_dbus()
        return True

    GLib.timeout_add_seconds(2, heartbeat)

    loop = GLib.MainLoop()
    event_thread = threading.Thread(target=loop.run, daemon=True)
    event_thread.start()

    offset = 0
    last_text = ""

    while True:
        with lock:
            status = state["status"]
            full_text = state["text"]

        if not status or status == "Stopped" or not full_text:
            out = {"text": "", "tooltip": "No playback", "class": "empty"}
            print(json.dumps(out, ensure_ascii=False), flush=True)
            offset = 0
            last_text = ""
            time.sleep(1.0)
            continue

        if full_text != last_text:
            last_text = full_text
            offset = 0

        text_len = len(full_text)
        if text_len <= MAX_CHARS:
            slice_text = full_text
        else:
            stream = full_text + SEP
            stream_len = len(stream)
            double_stream = stream + stream
            slice_text = double_stream[offset:offset + MAX_CHARS]

            if status == "Playing":
                offset = (offset + 1) % stream_len

        if status == "Playing":
            icon = " 󰝚  "
            css_class = "playing"
            tooltip = "Playing..."
        else:
            icon = " 󰏤  "
            css_class = "paused"
            tooltip = "Paused..."

        out = {
            "text": f"{icon}{slice_text}",
            "tooltip": tooltip,
            "class": css_class
        }
        print(json.dumps(out, ensure_ascii=False), flush=True)

        if status == "Playing":
            time.sleep(TICK_INTERVAL)
        else:
            time.sleep(0.5)

if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
