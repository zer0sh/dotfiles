" Vim-Airline theme loader for Matugen
" Loads the airline palette generated by Matugen from ~/.config/themes/current/matugen.vim

let s:theme_path = expand("~/.config/themes/current/matugen.vim")
if filereadable(s:theme_path) && !exists("g:airline#themes#matugen#palette")
    " Source only when the palette is missing to avoid re-running (and
    " clearing) the colorscheme when the theme is already active
    execute "source " . fnameescape(s:theme_path)
endif
